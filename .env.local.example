# ── Contact pipeline ────────────────────────────────────────────────
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=kyleelinmccarthy@gmail.com

# Verified Resend sending identity on the kyleemccarthy.com domain.
CONTACT_FROM_EMAIL=Kylee McCarthy <noreply@kyleemccarthy.com>

# ── Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ──
# Server-side secret. Use the Turnstile test secret in dev:
#   1x0000000000000000000000000000000AA  (always passes)
TURNSTILE_SECRET_KEY=

# Public site key (exposed to the browser). Test site key in dev:
#   1x00000000000000000000AA  (always passes, visible widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Canonical site URL (used for metadata, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://kyleemccarthy.com
